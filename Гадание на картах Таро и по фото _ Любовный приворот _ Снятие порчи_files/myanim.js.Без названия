document.addEventListener("DOMContentLoaded", function() {
  const style = document.createElement('style');
  style.textContent = `

    @keyframes pulsew {
      0% { transform: scale(0.7); }
      50% { transform: scale(1); }
      100% { transform: scale(0.7); }
    }
    @keyframes rotaterightw {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    @keyframes rotateleftw {
      from { transform: rotate(0deg); }
      to { transform: rotate(-360deg); }
    }
    @keyframes swingw {
      20% { transform: rotate(15deg); }
      40% { transform: rotate(-10deg); }
      60% { transform: rotate(5deg); }
      80% { transform: rotate(-5deg); }
      100% { transform: rotate(0deg); }
    }
    @keyframes bloww {
      0% { transform: scale(0.5); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }
    @keyframes hangw {
      0% { transform: translateY(-100%); opacity: 0; }
      100% { transform: translateY(0); opacity: 1; }
    }
    @keyframes flashw {
      0%, 50%, 100% { opacity: 1; }
      25%, 75% { opacity: 0.3; }
    }
    @keyframes fadeindownw {
      from { opacity: 0; transform: translateY(-80px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes flips_1 {
      0% { transform: perspective(400px) rotateY(90deg); opacity: 0; }
      50% { transform: perspective(400px) rotateY(-15deg); }
      75% { transform: perspective(400px) rotateY(10deg); }
      100% { transform: perspective(400px) rotateY(0deg); opacity: 1; }
    }
    @keyframes rollInw {
      from { opacity: 0; transform: translateX(-100%) rotate(-120deg); }
      to { opacity: 1; transform: translateX(0) rotate(0deg); }
    }

    [title="rollInw"] {
      opacity: 0;
      transform-origin: center;
    }
    [title="fade-upw"] {
      opacity: 0;
      transform: translateY(30px);
      transition: all 2s ease-out;
    }
    [title="fadew"] {
      opacity: 0;
      transition: all 2s ease-out;
    }
    [title="bounceLeftw"] {
      opacity: 0;
      transform: translateX(-90px);
      transition: all 2s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    }
    [title="bounceRightw"] {
      opacity: 0;
      transform: translateX(90px);
      transition: all 2s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    }
    [title="barw"] {
      opacity: 0;
      transform: scale(0.5);
      transition: all 2s ease-out;
      transform-origin: center;
    }
    [title="flipw"] {
      opacity: 0;
      transform: rotateY(90deg);
      transition: all 2s ease-out;
      transform-origin: center;
    }
    [title="dropw"] {
      opacity: 0;
      transform: translateY(-90px);
      transition: all 2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      transform-origin: center bottom;
    }
    [title="bloww"] {
      opacity: 0;
      transform: scale(0.5);
      transition: all 2s cubic-bezier(0.165, 0.84, 0.44, 1);
      transform-origin: center bottom;
    }
    [title="hangw"] {
      opacity: 0;
      transform: translateY(-100%);
      transition: all 2s ease-out;
      transform-origin: center top;
    }
    [title="glideLeftw"] {
      opacity: 0;
      transform: translateX(100px);
      transition: all 1.5s ease-out;
    }
    [title="glideRightw"] {
      opacity: 0;
      transform: translateX(-100px);
      transition: all 1.5s ease-out;
    }
    [title="spaceDownw"] {
      opacity: 0;
      transform: translateY(-200%);
      transition: all 2.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    [title="blurw"] {
      opacity: 0;
      filter: blur(20px);
      transform: scale(1.3);
      transition: all 1.3s ease-out;
      transform-origin: center;
    }
    [title="fadeindownw"] {
      opacity: 0;
      transform: translateY(-80px);
      transition: all 2s cubic-bezier(0.23, 1, 0.32, 1);
    }
    [title="fadeoutw"] {
      opacity: 1;
      transition: opacity 2s ease-out;
    }
    [title="bounceoutRightw"] {
      opacity: 1;
      transform: translateX(0);
      transition: all 2s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    }
    [title="baroutw"] {
      opacity: 1;
      transform: scale(1);
      transition: all 2s ease-out;
      transform-origin: center;
    }

    [title="pulsew"] {
      animation: pulsew 6s infinite;
      transform-origin: center;
    }
    [title="rotaterightw"] {
      animation: rotaterightw 6s infinite linear;
      transform-origin: center;
    }
    [title="rotateleftw"] {
      animation: rotateleftw 6s infinite linear;
      transform-origin: center;
    }
    [title="swingw"] {
      animation: swingw 3s infinite ease-in-out;
      transform-origin: center;
    }
    [title="flashw"] {
      animation: flashw 1.8s infinite;
    }
    [title="flipsuw"] {
      animation: flips_1 2.5s infinite alternate;
      transform-origin: center center;
    }
  `;
  document.head.appendChild(style);

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const animType = entry.target.title;
        
        const appearAnimations = [
          'fade-upw', 'fadew', 'bounceLeftw', 'bounceRightw',
          'barw', 'blurw', 'flipw', 'dropw', 'bloww', 'hangw',
          'glideLeftw', 'glideRightw', 'spaceDownw', 'fadeindownw', 'rollInw'
        ];

        const disappearAnimations = [
          'fadeoutw', 'bounceoutRightw', 'baroutw'
        ];

        if (appearAnimations.includes(animType)) {
          if (animType === 'rollInw') {
            entry.target.style.opacity = '';
            entry.target.style.transform = '';
            entry.target.style.animation = 'rollInw 1.5s ease-out forwards';
          } else {
            entry.target.style.opacity = '1';
            entry.target.style.transform = 'none';
            entry.target.style.filter = 'none';
          }
          observer.unobserve(entry.target);
        }
        else if (disappearAnimations.includes(animType)) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = animType === 'bounceoutRightw' ? 'translateX(0)' : 
                                       animType === 'baroutw' ? 'scale(1)' : 'none';
          
          setTimeout(() => {
            if (animType === 'fadeoutw') {
              entry.target.style.opacity = '0';
            } 
            else if (animType === 'bounceoutRightw') {
              entry.target.style.transform = 'translateX(100px)';
              entry.target.style.opacity = '0';
            }
            else if (animType === 'baroutw') {
              entry.target.style.transform = 'scale(0.5)';
              entry.target.style.opacity = '0';
            }
          }, 300);
        }
      }
    });
  }, { threshold: 0.5 });

  const animatableElements = document.querySelectorAll(
    '[title="fade-upw"], [title="fadew"], [title="bounceLeftw"], ' +
    '[title="bounceRightw"], [title="barw"], [title="blurw"], ' +
    '[title="flipw"], [title="dropw"], [title="bloww"], ' +
    '[title="hangw"], [title="glideLeftw"], [title="glideRightw"], ' +
    '[title="spaceDownw"], [title="fadeindownw"], ' +
    '[title="rollInw"], ' +
    '[title="fadeoutw"], [title="bounceoutRightw"], [title="baroutw"], ' +
    '[title="pulsew"], [title="rotaterightw"], [title="rotateleftw"], ' +
    '[title="swingw"], [title="flashw"], [title="flipsuw"]'
  );

  document.querySelectorAll('[title="fadeoutw"], [title="bounceoutRightw"], [title="baroutw"]').forEach(el => {
    el.style.opacity = '1';
    if (el.title === 'bounceoutRightw') el.style.transform = 'translateX(0)';
    if (el.title === 'baroutw') el.style.transform = 'scale(1)';
  });

  animatableElements.forEach(el => {
    observer.observe(el);
  });
});